# Dev Environment Configuration
# =============================
#
# This file defines which repositories to clone for your development environment.
# Copy this file to `dev-env.yaml` and customize, or use a preset:
#
#   ./setup.sh init <preset>              Initialize from a bundled preset
#   ./setup.sh init <url>                 Initialize from an external preset git URL
#   ./setup.sh init <url#subdir>          Preset pack repo containing multiple presets
#   ./setup.sh clone                      Clone all repos defined in dev-env.yaml
#   ./setup.sh status                     Show clone status for all repos
#   ./setup.sh refresh-preset             Re-fetch preset from its recorded source
#
# Available bundled presets are in the `presets/` directory.
#
# Schema:
#
#   preset:                      # Auto-generated by ./setup.sh init — do not edit manually
#     name: <preset-name>        # Preset name (from preset.yaml)
#     source: bundled            # 'bundled' for local presets, or the git URL for external ones
#     ref: <sha>                 # (external only) commit SHA recorded at fetch time
#     subdir: <subdir>           # (external only) subdirectory within the pack repo
#
#   repos:
#     - name: <repo-name>           # Short name (used as identifier and directory name)
#       url: <git-url>              # Full git clone URL
#       branch: <branch>            # Branch to clone (main, master, tag, etc.)
#       category: <category>        # One of: docs, development, testing, deployment, troubleshooting
#       summary: <one-liner>        # Brief description of the repo's role
#       directory: <dir-name>       # (Optional) Directory name under repos/ — defaults to name
#
# All repos are cloned using --filter=blob:none (blobless clone):
#   - Full repo structure visible, all files accessible
#   - Blob contents fetched on-demand when read
#   - Much faster initial clone, smaller disk footprint

repos:
  # Example entry:
  # - name: my-repo
  #   url: https://github.com/org/my-repo.git
  #   branch: main
  #   category: development
  #   summary: "Description of what this repo does"
