# Dev Environment Configuration
# =============================
#
# This file lives in your *workspace* and defines which repositories to clone.
# It is normally generated by the workspace plugin's setup skills:
#
#   /workspace:setup-environment          Set up / refresh a workspace from a domain
#   /workspace:create-domain              Build a custom workspace from arbitrary repos
#
# Those skills invoke the bundled setup.sh (init / clone / status /
# refresh-domain) with a --workspace pointing at this directory.
#
# Schema:
#
#   domain:                      # Auto-generated by ./setup.sh init — do not edit manually
#     name: <domain-name>        # Domain name (from domain.yaml)
#     source: bundled            # 'bundled' for local domains, or the git URL for external ones
#     ref: <sha>                 # (external only) commit SHA recorded at fetch time
#     subdir: <subdir>           # (external only) subdirectory within the pack repo
#
#   self:                        # Single-repo self-workspace marker — the
#     name: <repo-name>          # workspace root IS the repo checkout.
#     summary: <one-liner>       # Generated by `setup.sh init --self`;
#                                # mutually exclusive with `domain:`.
#
#   repos:
#     - name: <repo-name>           # Short name (used as identifier and directory name)
#       url: <git-url>              # Full git clone URL
#       branch: <branch>            # Branch to clone (main, master, tag, etc.)
#       category: <category>        # One of: docs, development, testing, deployment, troubleshooting
#       summary: <one-liner>        # Brief description of the repo's role
#       directory: <dir-name>       # (Optional) Directory name under repos/ — defaults to name
#
# All repos are cloned using --filter=blob:none (blobless clone):
#   - Full repo structure visible, all files accessible
#   - Blob contents fetched on-demand when read
#   - Much faster initial clone, smaller disk footprint

repos:
  # Example entry:
  # - name: my-repo
  #   url: https://github.com/org/my-repo.git
  #   branch: main
  #   category: development
  #   summary: "Description of what this repo does"
